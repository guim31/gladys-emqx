{
  "manifest_version": 1,
  "type": "device",
  "name": "EMQX",
  "description": {
    "en": "The health of your EMQX MQTT broker in Gladys: clients, message rates, alarms, outages.",
    "fr": "La santé de votre broker MQTT EMQX dans Gladys : clients, débit de messages, alarmes, pannes.",
    "de": "Der Zustand deines EMQX-MQTT-Brokers in Gladys: Clients, Nachrichtenrate, Alarme, Ausfälle.",
    "es": "La salud de su broker MQTT EMQX en Gladys: clientes, mensajes por minuto, alarmas, caídas."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-emqx:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-emqx/main/cover.png",
  "categories": ["network"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Connect EMQX",
        "fr": "Connecter EMQX",
        "de": "EMQX verbinden",
        "es": "Conectar EMQX"
      },
      "description": {
        "en": "The integration reads the REST API of EMQX 5 or 6 with an API key, every 30 seconds. It never changes anything. Create the key in the dashboard: System → API Key.",
        "fr": "L'intégration lit l'API REST d'EMQX 5 ou 6 avec une clé d'API, toutes les 30 secondes. Elle ne modifie jamais rien. Créez la clé dans le tableau de bord : Système → Clé d'API.",
        "de": "Die Integration liest alle 30 Sekunden die REST-API von EMQX 5 oder 6 mit einem API-Schlüssel. Die Integration ändert nie etwas. Erstelle den Schlüssel im Dashboard: System → API Key.",
        "es": "La integración lee la API REST de EMQX 5 o 6 con una clave de API, cada 30 segundos. Nunca modifica nada. Cree la clave en el panel: Sistema → Clave de API."
      },
      "links": [
        {
          "url": "https://docs.emqx.com/en/emqx/latest/admin/api.html",
          "label": {
            "en": "The REST API of EMQX",
            "fr": "L'API REST d'EMQX",
            "de": "Die REST-API von EMQX",
            "es": "La API REST de EMQX"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "required": true,
      "label": {
        "en": "Address of EMQX",
        "fr": "Adresse d'EMQX",
        "de": "Adresse von EMQX",
        "es": "Dirección de EMQX"
      },
      "description": {
        "en": "The address of the dashboard, port 18083 by default (http:// or https://).",
        "fr": "L'adresse du tableau de bord, port 18083 par défaut (http:// ou https://).",
        "de": "Die Adresse des Dashboards, standardmäßig Port 18083 (http:// oder https://).",
        "es": "La dirección del panel, puerto 18083 por defecto (http:// o https://)."
      },
      "placeholder": {
        "en": "e.g. http://emqx.local:18083",
        "fr": "ex. http://emqx.local:18083",
        "de": "z. B. http://emqx.local:18083",
        "es": "p. ej. http://emqx.local:18083"
      }
    },
    {
      "key": "api_key",
      "type": "string",
      "required": true,
      "label": {
        "en": "API key",
        "fr": "Clé d'API",
        "de": "API-Schlüssel",
        "es": "Clave de API"
      },
      "description": {
        "en": "Read access is enough: the Viewer role when EMQX offers one.",
        "fr": "Un accès en lecture suffit : le rôle Viewer quand EMQX le propose.",
        "de": "Lesezugriff genügt: die Rolle Viewer, wenn EMQX sie anbietet.",
        "es": "Basta con acceso de lectura: el rol Viewer cuando EMQX lo ofrece."
      }
    },
    {
      "key": "api_secret",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Secret key",
        "fr": "Clé secrète",
        "de": "Geheimer Schlüssel",
        "es": "Clave secreta"
      },
      "description": {
        "en": "Shown once by EMQX when the key is created.",
        "fr": "Affichée une seule fois par EMQX à la création de la clé.",
        "de": "Wird von EMQX nur einmal beim Erstellen des Schlüssels angezeigt.",
        "es": "EMQX la muestra una sola vez al crear la clave."
      }
    },
    {
      "key": "tls_insecure",
      "type": "boolean",
      "default": false,
      "label": {
        "en": "Accept a self-signed certificate",
        "fr": "Accepter un certificat auto-signé",
        "de": "Selbstsigniertes Zertifikat akzeptieren",
        "es": "Aceptar un certificado autofirmado"
      },
      "description": {
        "en": "https:// only: the certificate of EMQX is then not checked.",
        "fr": "https:// seulement : le certificat d'EMQX n'est alors pas vérifié.",
        "de": "Nur https://: Das Zertifikat von EMQX wird dann nicht geprüft.",
        "es": "Solo https://: el certificado de EMQX no se comprueba."
      }
    },
    {
      "key": "client_ids",
      "type": "string",
      "label": {
        "en": "MQTT clients to follow",
        "fr": "Clients MQTT à suivre",
        "de": "Zu beobachtende MQTT-Clients",
        "es": "Clientes MQTT que seguir"
      },
      "description": {
        "en": "Client ids separated by commas, 20 at most: each one becomes a device (connected, last connection). They are listed on the Clients page of the dashboard.",
        "fr": "Identifiants de clients séparés par des virgules, 20 au plus : chacun devient un appareil (connecté, dernière connexion). Ils figurent sur la page Clients du tableau de bord.",
        "de": "Client-IDs durch Kommas getrennt, höchstens 20: Jeder wird ein Gerät (verbunden, letzte Verbindung). Die IDs stehen auf der Seite Clients des Dashboards.",
        "es": "Identificadores de clientes separados por comas, 20 como máximo: cada uno se convierte en un dispositivo (conectado, última conexión). Aparecen en la página Clientes del panel."
      },
      "placeholder": {
        "en": "e.g. zigbee2mqtt, shelly-garage",
        "fr": "ex. zigbee2mqtt, shelly-garage",
        "de": "z. B. zigbee2mqtt, shelly-garage",
        "es": "p. ej. zigbee2mqtt, shelly-garage"
      }
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of the texts",
        "fr": "Langue des textes",
        "de": "Sprache der Texte",
        "es": "Idioma de los textos"
      },
      "description": {
        "en": "Feature names of the devices when they are added, scene sentences and action messages.",
        "fr": "Noms des fonctionnalités des appareils à leur ajout, phrases des scènes et messages des actions.",
        "de": "Namen der Funktionen der Geräte beim Hinzufügen, Szenen-Sätze und Meldungen der Aktionen.",
        "es": "Nombres de las funciones de los dispositivos al añadirlos, frases de escenas y mensajes de las acciones."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Reads EMQX now: version, key numbers, alarms in progress and followed clients.",
        "fr": "Lit EMQX tout de suite : version, chiffres clés, alarmes en cours et clients suivis.",
        "de": "Liest EMQX sofort: Version, Kennzahlen, aktive Alarme und beobachtete Clients.",
        "es": "Lee EMQX ahora mismo: versión, cifras clave, alarmas activas y clientes seguidos."
      }
    }
  ],
  "scene_triggers": [
    {
      "key": "broker_unreachable",
      "label": {
        "en": "EMQX: broker unreachable",
        "fr": "EMQX : broker injoignable",
        "de": "EMQX: Broker nicht erreichbar",
        "es": "EMQX: broker inaccesible"
      },
      "description": {
        "en": "The EMQX API has not answered for the chosen time. A restart of a few seconds fires nothing.",
        "fr": "L'API d'EMQX ne répond plus depuis la durée choisie. Un redémarrage de quelques secondes ne déclenche rien.",
        "de": "Die API von EMQX antwortet seit der gewählten Dauer nicht. Ein Neustart von wenigen Sekunden löst nichts aus.",
        "es": "La API de EMQX no responde desde hace el tiempo elegido. Un reinicio de unos segundos no activa nada."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Broker",
            "fr": "Broker",
            "de": "Broker",
            "es": "Broker"
          }
        },
        {
          "key": "after_minutes",
          "type": "select",
          "required": true,
          "default": "5",
          "label": {
            "en": "Unreachable for",
            "fr": "Injoignable depuis",
            "de": "Nicht erreichbar seit",
            "es": "Inaccesible desde hace"
